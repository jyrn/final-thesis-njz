# Server
PORT=5000

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.<clusterid>.mongodb.net/<databaseName>?retryWrites=true&w=majority

# Authentication / Security
JWT_SECRET=yourSuperSecretKey123

# (Optional) If using email notifications
EMAIL_USER=yourEmail@example.com
EMAIL_PASS=yourEmailPassword

# (Optional) For cloud storage like AWS S3, Firebase, etc.
CLOUD_API_KEY=yourCloudApiKey
CLOUD_SECRET=yourCloudSecret
